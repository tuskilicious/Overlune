// Cloudflare Pages config (T7.2). Once this file exists it is the source of truth for the project: the dashboard can
// no longer edit these fields, and `vars` here replace the dashboard's plain variables, at build time too. Secrets
// (TWITCH_CLIENT_ID, TWITCH_CLIENT_SECRET, SENTRY_AUTH_TOKEN) stay in the dashboard and are never written here.
// Pages environments don't inherit: preview and production each list everything. Top level is local development.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "overlune",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-30",
  // @sentry/cloudflare needs AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NODE_VERSION": "24",
    "VITE_SENTRY_ENVIRONMENT": "development",
    "AUTH_ORIGIN": "http://localhost:8788",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "overlune-staging",
      "database_id": "e345b820-48d2-4d1b-a637-1f86e914069e",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    // Every PR's preview deploy: the staging database and the staging Sentry environment.
    "preview": {
      "vars": {
        "NODE_VERSION": "24",
        "VITE_SENTRY_DSN": "https://26398e09d381b7786ca7ea853b4a063f@o4512174345224192.ingest.de.sentry.io/4512174371766352",
        "VITE_SENTRY_ENVIRONMENT": "staging",
        // Sign-in comes back to the staging alias (the "staging" branch): its Twitch app lists only that address.
        "AUTH_ORIGIN": "https://staging.overlune.pages.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "overlune-staging",
          "database_id": "e345b820-48d2-4d1b-a637-1f86e914069e",
          "migrations_dir": "migrations",
        },
      ],
    },
    // main, at overlune.in.
    "production": {
      "vars": {
        "NODE_VERSION": "24",
        "VITE_SENTRY_DSN": "https://26398e09d381b7786ca7ea853b4a063f@o4512174345224192.ingest.de.sentry.io/4512174371766352",
        "VITE_SENTRY_ENVIRONMENT": "production",
        "AUTH_ORIGIN": "https://overlune.in",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "overlune-production",
          "database_id": "76314ef1-fc0c-421f-a9f8-f10dc4df272a",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
