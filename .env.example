# Client-side (public; safe to ship to the browser)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=

# Build-only secret (never in client code): set it only in Cloudflare Pages' production build to upload source maps.
SENTRY_AUTH_TOKEN=

# Local tooling only, optional: the 21st.dev plugin for Claude Code (README, "Optional tooling"). Not an app variable:
# no VITE_ prefix, so the build never ships it. Set it in .env.local or the plugin's settings; never in CI or a URL.
API_KEY_21ST=
