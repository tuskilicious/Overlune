# Client-side (public; safe to ship to the browser)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=

# Build-only secret (never in client code): a GitHub Actions secret, used only by production builds to upload source maps.
SENTRY_AUTH_TOKEN=

# The API (server only, v2). Worker secrets (wrangler secret put); locally in .dev.vars (git ignores it), with
# VITE_SENTRY_DSN= (empty), VITE_SENTRY_ENVIRONMENT=development and AUTH_ORIGIN=http://localhost:8787 (README, "Run").
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Local tooling only, optional: the 21st.dev plugin for Claude Code (README, "Optional tooling"). Not an app variable:
# no VITE_ prefix, so the build never ships it. Set it in .env.local or the plugin's settings; never in CI or a URL.
API_KEY_21ST=
